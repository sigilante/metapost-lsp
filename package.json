{
  "name": "metapost-lsp",
  "version": "0.1.0",
  "description": "Language server for MetaPost and METAFONT: definitions, references, hover, completion, outline, and mpost diagnostics.",
  "license": "MIT",
  "author": "sigilante",
  "repository": {
    "type": "git",
    "url": "https://github.com/sigilante/metapost-lsp"
  },
  "keywords": [
    "metapost",
    "metafont",
    "lsp",
    "language-server"
  ],
  "main": "out/src/server.js",
  "bin": {
    "metapost-lsp": "out/src/server.js"
  },
  "files": [
    "out/src/**/*.js",
    "out/src/**/*.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -p . --watch",
    "prepare": "tsc -p .",
    "test": "tsc -p . && node --test \"out/test/**/*.test.js\""
  },
  "dependencies": {
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "vscode-jsonrpc": "^9.0.3"
  }
}
